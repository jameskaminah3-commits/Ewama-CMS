# API server
PORT=5000

# Supabase project settings
# Use the pooled or direct Postgres connection string from Supabase Project Settings > Database.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Master admin login for /admin (works without Supabase Auth). The admin can
# later set their own password from Settings; this one stays as a backup.
ADMIN_EMAIL=info@ewamaproperties.com
ADMIN_PASSWORD=

# Optional: comma-separated list of extra emails allowed into /admin.
# ADMIN_EMAIL is always allowed. Leave empty to rely on ADMIN_EMAIL alone.
ADMIN_EMAIL_ALLOWLIST=

# Email (Resend) for password-reset codes and booking/enquiry notifications
RESEND_API_KEY=
RESEND_FROM=EWAMA Properties <info@ewamaproperties.com>
ADMIN_NOTIFY_EMAIL=info@ewamaproperties.com
